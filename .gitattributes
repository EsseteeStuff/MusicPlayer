# Git LFS alleen voor echte binaire bestanden.
# Tekstbestanden (readme's, broncode, scripts, LICENSE) blijven gewone
# git-bestanden, zodat ze op GitHub direct leesbaar zijn.
*.qm filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.deb filter=lfs diff=lfs merge=lfs -text
*.rpm filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text
